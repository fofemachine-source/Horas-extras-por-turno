/** Monta o HTML com os dados embutidos. */
export function gerarHtmlCompartilhado(dados: DadosPainel): string {
  const pacote = {
    full: 1,
    savedAt: new Date().toISOString(),
    data: { people: dados.people, cad: dados.cad, exc: dados.exc, names: dados.names, obra: dados.obra, periodo: dados.periodo, demo: !!dados.demo },
  };
  const json = JSON.stringify(pacote).replace(/</g, "\\u003c");
  return MODELO_HTML.replace("__DADOS__", () => json);
}

/** Nome do arquivo: Painel_Horas_Extras[_EXEMPLO]_<obra>_<período>.html */
export function nomeArquivoCompartilhado(dados: DadosPainel): string {
  const per = (dados.periodo || "").replace(/\s*a\s*/i, "_a_").replace(/[^0-9_a]/gi, "-").replace(/-+/g, "-");
  return "Painel_Horas_Extras" + (dados.demo ? "_EXEMPLO" : "") + (dados.obra ? "_" + dados.obra.replace(/[^\w-]+/g, "") : "") + (per ? "_" + per : "") + ".html";
}

/** Baixa o arquivo no navegador (pasta Downloads). */
export function baixarHtmlCompartilhado(dados: DadosPainel): string {
  const nome = nomeArquivoCompartilhado(dados);
  const blob = new Blob([gerarHtmlCompartilhado(dados)], { type: "text/html;charset=utf-8" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob); a.download = nome;
  document.body.appendChild(a); a.click();
  setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1000);
  return nome;
}
